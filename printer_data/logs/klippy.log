gcode = 
	SAVE_GCODE_STATE NAME=UNLOAD_PETG_STATE
	M109 S250
	M83
	G1 E-100 F1800
	M104 S0
	RESTORE_GCODE_STATE NAME=UNLOAD_PETG_STATE
	M117 PETG Unloaded

