[gcode_macro M600]
gcode = 
	{% set X = 50 %}
	{% set Y = 0 %}
	{% set Z = 10 %}
	SAVE_GCODE_STATE NAME=M600_state
	PAUSE
	G91
	G1 E-.8 F2700
	G1 Z{Z}
	G90
	G1 X{X} Y{Y} F3000
	G91
	G1 E-50 F1000
	RESTORE_GCODE_STATE NAME=M600_state

[gcode_macro M92]
