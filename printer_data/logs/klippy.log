	BED_MESH_PROFILE LOAD=default

[gcode_macro LOAD_TEMP]
gcode = 
	M104 S220
	M109 S220

[gcode_macro UNLOAD_PLA]
description = Heats hotend to 220C and retracts PLA filament
gcode = 
	SAVE_GCODE_STATE NAME=UNLOAD_PLA_STATE
	M109 S220
	M83
	G1 E-100 F1800
	M104 S0
	RESTORE_GCODE_STATE NAME=UNLOAD_PLA_STATE
	M117 PLA Unloaded

[gcode_macro UNLOAD_PETG]
