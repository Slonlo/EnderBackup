restart_method = command

[printer]
kinematics = cartesian
max_velocity = 800
max_accel = 6000
max_z_velocity = 20
max_z_accel = 200

[bltouch]
sensor_pin = ^PB1
control_pin = PB0
x_offset = -41
y_offset = -4
speed = 20
samples = 1
sample_retract_dist = 8.0
stow_on_each_sample = false
z_offset = 1.380

[safe_z_home]
