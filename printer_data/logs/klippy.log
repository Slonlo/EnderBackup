speed = 200
z_hop = 10
z_hop_speed = 40

[bed_mesh]
speed = 190
mesh_min = 20,20
mesh_max = 185,185
probe_count = 15,15
fade_start = 1
fade_end = 10
fade_target = 0
algorithm = bicubic

[bed_screws]
screw1 = 27, 31
screw2 = 195, 31
screw3 = 27, 201
screw4 = 195, 201

[firmware_retraction]
retract_length = 0
retract_speed = 20
unretract_extra_length = 0
unretract_speed = 10

[input_shaper]
shaper_freq_x = 45.8
shaper_freq_y = 57.5
shaper_type = mzv

[gcode_macro G29]
gcode = 
	G28 X0 Y0
	G28 Z0
	G0 Z5 F1200
	BED_MESH_CALIBRATE
	BED_MESH_PROFILE SAVE=Mesh1
	G28

[gcode_macro M600]
gcode = 
	{% set X = 50 %}
	{% set Y = 0 %}
	{% set Z = 10 %}
	SAVE_GCODE_STATE NAME=M600_state
	PAUSE
	G91
	G1 E-.8 F2700
	G1 Z{Z}
	G90
	G1 X{X} Y{Y} F3000
	G91
	G1 E-50 F1000
	RESTORE_GCODE_STATE NAME=M600_state

[gcode_macro M92]
gcode = 
	M221

[gcode_macro WLED_ON]
description = Turn WLED strip on using optional preset and resets led colors
gcode = 
	{% set strip = params.STRIP|default("printerled")|string %}
	{% set preset = params.PRESET|default(4)|int %}
	
	{action_call_remote_method("set_wled_state",
	strip=strip,
	state=True,
	preset=preset)}

[gcode_macro led_heating]
gcode = 
	WLED_ON STRIP=printerled PRESET=2

[gcode_macro led_printing]
gcode = 
	WLED_ON STRIP=printerled PRESET=1

[gcode_macro led_complete]
gcode = 
	WLED_ON STRIP=printerled PRESET=4

[gcode_macro led_mesh]
gcode = 
	WLED_ON STRIP=printerled PRESET=3

[gcode_macro led_pause]
gcode = 
	WLED_ON STRIP=printerled PRESET=1

[gcode_macro led_cancel]
gcode = 
	WLED_ON STRIP=printerled PRESET=5

[gcode_macro led_off]
gcode = 
	WLED_ON STRIP=printerled PRESET=6

[gcode_macro POWER_OFF_PRINTER]
gcode = 
	{action_call_remote_method(
	"set_device_power", device="Power", state="off"
	)}

[idle_timeout]
gcode = 
	TURN_OFF_HEATERS
	G28 X0 Y0
	G0 F6000
	G0 X10 Y150
	M84
	led_off
	POWER_OFF_PRINTER
	M118 Going to sleep.
timeout = 900

