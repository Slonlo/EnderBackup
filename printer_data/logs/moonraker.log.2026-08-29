locked_while_printing = False
bound_services = 
	klipper
	klipper-mcu

[wled printerled]
type = http
address = 192.168.1.154
initial_red = 0.0
initial_green = 0.0
initial_blue = 0.0
chain_count = 20

[job_queue]
load_on_startup = True

