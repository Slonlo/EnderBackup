dir_pin = PB7
enable_pin = !PC3
microsteps = 16
rotation_distance = 39.89
endstop_pin = ^PA6
position_endstop = 0
position_max = 220
homing_speed = 120

[stepper_z]
step_pin = PB6
dir_pin = !PB5
enable_pin = !PC3
microsteps = 16
rotation_distance = 8
endstop_pin = probe:z_virtual_endstop
position_max = 235
position_min = -3
homing_speed = 42
second_homing_speed = 1
homing_retract_dist = 2.0

[extruder]
max_extrude_only_distance = 1000.0
pressure_advance = 0.02
pressure_advance_smooth_time = 0.05
step_pin = PB4
dir_pin = PB3
enable_pin = !PC3
microsteps = 16
gear_ratio = 42:12
rotation_distance = 26.359
nozzle_diameter = 0.400
filament_diameter = 1.750
heater_pin = PA1
sensor_type = EPCOS 100K B57560G104F
sensor_pin = PC5
min_extrude_temp = 170
min_temp = 0
max_temp = 300
max_extrude_cross_section = 5
control = pid
pid_kp = 23.561
pid_ki = 1.208
pid_kd = 114.859

[heater_bed]
